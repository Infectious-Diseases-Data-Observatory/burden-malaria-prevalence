# ---- Raw / access-controlled / large data (NOT shared) ----
data/
archive/
# old exploratory byproducts, superseded by results/
output/

# Data file types anywhere
*.rds
*.tif
*.tiff
*.gpkg
*.zip
*.ZIP
*.png.aux.xml

# Rendered outputs of SUMMARY.md + LaTeX/Word build cruft (regenerate from the .md)
*.pdf
*.html
*.docx
*.tex
*.log
*.aux
*.out
~$*
*_files/

# ---- R session cruft ----
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ---- editor / local tooling ----
.claude/
results/_*.log

# ---- OS ----
.DS_Store

# ---- Keep (explicitly tracked despite rules above) ----
!results/
!results/*.png
!results/*.csv
# rendered summary is tracked & shared (other *.pdf stay ignored)
!SUMMARY.pdf
